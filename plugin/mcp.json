{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "unpkg": {
      "type": "streamable-http",
      "url": "https://mcp.unpkg.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["shield:read", "shield:simulate"]
          }
        }
      }
    }
  }
}
