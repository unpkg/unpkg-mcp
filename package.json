{
  "name": "unpkg-mcp",
  "version": "1.0.0",
  "description": "Remote MCP server for UNPKG: live npm resolution, file discovery, and project audits for direct UNPKG file lookups",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify:browser": "bun scripts/verify-browser.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "semver": "^7.7.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250320.0",
    "@types/bun": "^1.4.4",
    "@types/semver": "^7.7.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.8.0",
    "wrangler": "^4.125.0"
  },
  "files": [
    "src",
    "skill",
    "examples",
    "README.md"
  ]
}
